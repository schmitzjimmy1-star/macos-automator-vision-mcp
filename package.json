{
  "name": "@schmitzjimmy1-star/macos-automator-vision-mcp",
  "version": "0.1.0",
  "description": "Mac Automator MCP with read-only native app inspection and screenshots.",
  "keywords": [
    "applescript",
    "automation",
    "jxa",
    "macos",
    "mcp"
  ],
  "homepage": "https://github.com/schmitzjimmy1-star/macos-automator-vision-mcp#readme",
  "bugs": {
    "url": "https://github.com/schmitzjimmy1-star/macos-automator-vision-mcp/issues"
  },
  "license": "MIT",
  "author": "Jimmy Schmitz; based on macos-automator-mcp by steipete",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmitzjimmy1-star/macos-automator-vision-mcp.git"
  },
  "bin": {
    "macos-automator-vision-mcp": "dist/server.js"
  },
  "files": [
    "dist/**/*",
    "knowledge_base/**/*",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "lint": "pnpm format:check && oxlint --deny-warnings src tests scripts",
    "format": "oxfmt --write .",
    "validate": "tsx scripts/validate-kb.ts",
    "test": "vitest run",
    "smoke:vision": "node scripts/live-vision-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
